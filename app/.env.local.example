# OpenAI API Key
OPENAI_API_KEY=sk-...

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=https://gijilai.com

# Firebase Analytics
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Kakao JavaScript SDK
NEXT_PUBLIC_KAKAO_JS_KEY=your-kakao-javascript-key

# Supabase Service Role (for server-side admin operations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PortOne
NEXT_PUBLIC_PORTONE_STORE_ID=store-...
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_KCP=channel-key-...
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_INICIS=channel-key-...
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_TOSS=channel-key-...
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_NAVERPAY=channel-key-...
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_STRIPE=channel-key-...
PORTONE_API_SECRET=portone-api-secret-...
PORTONE_WEBHOOK_SECRET=whsec_...
PORTONE_WEBHOOK_SECRET_SECONDARY=whsec_... # optional, during secret rotation
PORTONE_WEBHOOK_SECRETS=whsec_...,whsec_... # optional, comma-separated fallback list

# Apple IAP / App Store Server API
APPLE_IAP_ISSUER_ID=00000000-0000-0000-0000-000000000000
APPLE_IAP_KEY_ID=ABC123DEFG
APPLE_IAP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_BUNDLE_ID=com.devho.gijilai
APPLE_APP_STORE_ROOT_CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Optional legacy fallback only. Prefer dynamic JWT generation above because App Store Server API JWTs expire.
APPLE_IAP_JWT=

# Google Play IAP
GOOGLE_PLAY_CREDENTIALS={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}
GOOGLE_PLAY_PACKAGE_NAME=com.devho.gijilai
GOOGLE_RTDN_TOKEN=your-google-rtdn-shared-token

# Cron
CRON_SECRET=your-cron-secret
